def measure_target_latency(host, port=443, timeout=2):
    try:
        start_t = time.time()
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect((host, port))
        s.close()
        latency = round((time.time() - start_t) * 1000, 1)
        return int(latency)
    except Exception:
        return 0

