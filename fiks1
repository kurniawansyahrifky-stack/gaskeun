def recursive_unquote(data: str) -> str:
    for _ in range(3):
        decoded = unquote(data)
        if decoded == data: break
        data = decoded
    return data


# --- ANTI-DDoS / RATE LIMITER SEDERHANA ---
from collections import defaultdict
request_trackers = defaultdict(list)
RATE_LIMIT_MAX = 90  # Maksimal 90 request
RATE_LIMIT_PERIOD = 60 # per 60 detik (1 menit)

def check_rate_limit(ip):
    now = time.time()
    # Bersihkan history request lama di luar rentang waktu
    request_trackers[ip] = [t for t in request_trackers[ip] if now - t < RATE_LIMIT_PERIOD]
    if len(request_trackers[ip]) >= RATE_LIMIT_MAX:
        return True
    request_trackers[ip].append(now)
    return False


def global_waf_interceptor():
    client_ip = get_real_ip()
    if check_rate_limit(client_ip):
        return jsonify({"error": "Too Many Requests (Rate Limit Exceeded)"}), 429

    if request.path in ['/api/stats', '/api/store', '/api/trigger-backup', '/api/trigger-failover', '/api/add-client', '/api/delete-client']:
        return
    host = request.host.lower().split(':')[0]
    client_ip = get_real_ip()
    path = request.path
    if host in ["monitor.devgarf.my.id", "monitor.defgarf.my.id", "127.0.0.1", "localhost"]:
        return

    body_data = request.get_data(as_text=True)
    fully_decoded_req = recursive_unquote(f"{path} {request.query_string.decode('utf-8', errors='ignore')} {body_data} {request.headers.get('User-Agent', '')}").lower()
    threats = [name for name, pat in ANOMALY_PATTERNS.items() if re.search(pat, fully_decoded_req, re.IGNORECASE)]
    if path in HONEYPOT_TRAPS: threats.append("Honeypot Trap")

    if threats:
        with db_lock:
            conn = sqlite3.connect(DB_PATH)
            c = conn.cursor()
            c.execute("INSERT INTO logs (timestamp, ip, country, target_domain, method, path, is_threat, threats) VALUES (?, ?, 'ID 🇮🇩', ?, ?, ?, 1, ?)",
                      (datetime.now().strftime("%Y-%m-%d %H:%M:%S"), client_ip, host, request.method, path, ", ".join(threats)))
            conn.commit()
            conn.close()
        send_telegram(f"🚨 <b>WAF BLOCKED!</b>\nIP: <code>{client_ip}</code>\nTarget: {host}\nPath: <code>{html.escape(path)}</code>\nAncaman: {', '.join(threats)}")
        return jsonify({"error": "Blocked by WAF"}), 403

