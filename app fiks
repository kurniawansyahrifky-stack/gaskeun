def send_telegram(text):
    if not TELEGRAM_BOT_TOKEN or not TELEGRAM_CHAT_ID:
        return
    url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage"
    payload = {"chat_id": TELEGRAM_CHAT_ID, "text": text, "parse_mode": "HTML"}
    try:
        requests.post(url, json=payload, timeout=5)
    except:
        pass

def send_telegram_document(file_path, caption=""):
    if not TELEGRAM_BOT_TOKEN or not TELEGRAM_CHAT_ID:
        return False
    url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendDocument"
    try:
        with open(file_path, 'rb') as f:
            files = {'document': f}
            data = {'chat_id': TELEGRAM_CHAT_ID, 'caption': caption, 'parse_mode': 'HTML'}
            resp = requests.post(url, data=data, files=files, timeout=30)
            return resp.status_code == 200
    except:
        return False

def trigger_cloudflare_failover():
    if not CF_API_TOKEN or not CF_ZONE_ID or not CF_RECORD_ID:
        send_telegram("⚠️ <b>Gagal Failover DNS:</b> Konfigurasi Cloudflare belum lengkap!")
        return False

    url = f"https://api.cloudflare.com/client/v4/zones/{CF_ZONE_ID}/dns_records/{CF_RECORD_ID}"
    headers = {"Authorization": f"Bearer {CF_API_TOKEN}", "Content-Type": "application/json"}
    payload = {"content": BACKUP_TARGET_CNAME, "type": "CNAME"}

    try:
        resp = requests.patch(url, json=payload, headers=headers, timeout=10)
        if resp.status_code == 200 and resp.json().get("success"):
            send_telegram(
                f"🚨 <b>GARF FAILOVER EXECUTED!</b> 🚨\n"
                f"━━━━━━━━━━━━━━━━━━━━━━━━━\n"
                f"⚠️ Server utama terdeteksi Down.\n"
                f"🔄 DNS Cloudflare dialihkan ke VPS Cadangan:\n"
                f"👉 <code>{BACKUP_TARGET_CNAME}</code>"
            )
            return True
        else:
            send_telegram(f"❌ <b>Gagal update DNS Cloudflare:</b> {resp.text}")
            return False
    except Exception as e:
        send_telegram(f"❌ <b>Error Cloudflare API:</b> {e}")
        return False

def perform_system_backup(manual=False):
    timestamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    zip_filename = f"garf_backup_{timestamp}.zip"
    try:
        with db_lock:
            if not os.path.exists(DB_PATH):
                return False
            with zipfile.ZipFile(zip_filename, 'w', zipfile.ZIP_DEFLATED) as zipf:
                zipf.write(DB_PATH, arcname=os.path.basename(DB_PATH))

        caption = (
            f"🛡️ <b>GARF DISASTER RECOVERY SYSTEM</b> 🛡️\n"
            f"━━━━━━━━━━━━━━━━━━━━━\n"
            f"📦 <b>Status:</b> Auto-Backup Berhasil!\n"
            f"⚙️ <b>Jenis:</b> {'Manual Trigger' if manual else 'Scheduled Background'}\n"
            f"📅 <b>Waktu:</b> {timestamp}\n"
            f"💾 <b>Media:</b> Cloud Telegram Storage"
        )
        success = send_telegram_document(zip_filename, caption)
        if os.path.exists(zip_filename):
            os.remove(zip_filename)
        return success
    except:
        if os.path.exists(zip_filename):
            os.remove(zip_filename)
        return False

