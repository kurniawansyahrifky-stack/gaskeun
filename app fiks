@app.route('/<path:subpath>', methods=['GET', 'POST', 'PUT', 'DELETE'])
def proxy_handler(subpath):
    host = request.host.lower().split(':')[0]
    client_ip = get_real_ip()

    dashboard_hosts = ["monitor.devgarf.my.id", "monitor.defgarf.my.id", "127.0.0.1", "localhost"]
    if (host in dashboard_hosts or host.endswith("devgarf.my.id")) and subpath in ['dashboard', 'api/stats', 'api/store', 'api/trigger-backup', 'api/trigger-failover', 'api/add-client']:
        if subpath == 'api/store':
            return get_store_api()
        if subpath == 'api/trigger-backup':
            return api_trigger_backup()
        if subpath == 'api/trigger-failover':
            return api_trigger_failover()
        if subpath == 'api/add-client':
            return api_add_client()
        return render_dashboard()

    with db_lock:
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute("SELECT backend_url, client_name FROM client_targets WHERE domain = ? AND status = 'ACTIVE'", (host,))
        row = c.fetchone()
        conn.close()

    if not row:
        return render_template_string(PAGE_404), 404

    backend_url = row[0]
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    with db_lock:
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute("INSERT INTO logs (timestamp, ip, country, target_domain, method, path, is_threat, threats) VALUES (?, ?, 'ID 🇮🇩', ?, ?, ?, 0, '')",
                  (timestamp, client_ip, host, request.method, f"/{subpath}"))
        conn.commit()
        conn.close()

    target_url = f"{backend_url.rstrip('/')}/{subpath}"
    try:
        resp = requests.request(
            method=request.method,
            url=target_url,
            headers={k: v for k, v in request.headers if k != 'Host'},
            params=request.args,
            data=request.get_data(),
            cookies=request.cookies,
            allow_redirects=False,
            timeout=10
        )
        return Response(resp.content, resp.status_code)
    except Exception as e:
        return f"Proxy Error: {e}", 502


